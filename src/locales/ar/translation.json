    "goldWord": "\u064a\u0642\u0648\u0644",
    "items": {
      "item0": {
        "quote": "\u062d\u062c\u0632\u062a \u062e\u062f\u0645\u0629 \u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0644\u0648\u0627\u0644\u062f\u064a \u0645\u0646 \u0627\u0644\u0645\u0637\u0627\u0631 \u0641\u064a \u0627\u0644\u0642\u0627\u0647\u0631\u0629. \u0643\u0627\u0646 \u0627\u0644\u0633\u0627\u0626\u0642 \u062f\u0642\u064a\u0642\u0627\u064b \u0641\u064a \u0645\u0648\u0639\u062f\u0647\u060c \u0648\u0645\u0647\u0646\u064a\u0627\u064b \u0648\u0644\u0637\u064a\u0641\u0627\u064b \u0644\u0644\u063a\u0627\u064a\u0629. \u0643\u0627\u0646\u062a \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u063a\u0627\u064a\u0629 \u0641\u064a \u0627\u0644\u0646\u0638\u0627\u0641\u0629. \u0633\u0623\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0633\u064a\u0641 \u0644\u064a\u0645\u0648\u0632\u064a\u0646 \u062f\u0627\u0626\u0645\u0627\u064b.",
